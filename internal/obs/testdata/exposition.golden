# HELP knell_beats_received_total Accepted pings per beat (unknown ids are rejected and not counted).
# TYPE knell_beats_received_total counter
knell_beats_received_total{beat="backup"} 2
knell_beats_received_total{beat="cron-nightly"} 0
# HELP knell_beat_outages_total Detected outages per beat: one increment per deadline crossing detected, independent of notification delivery.
# TYPE knell_beat_outages_total counter
knell_beat_outages_total{beat="backup"} 0
knell_beat_outages_total{beat="cron-nightly"} 1
# HELP knell_outage_records_dropped_total Ended-outage records discarded per beat because the per-beat queue was full; no notice for them will ever arrive.
# TYPE knell_outage_records_dropped_total counter
knell_outage_records_dropped_total{beat="backup"} 0
knell_outage_records_dropped_total{beat="cron-nightly"} 1
# HELP knell_notifications_sent_total Webhook notifications delivered, by kind (missing, recovered, history); one per delivered message.
# TYPE knell_notifications_sent_total counter
knell_notifications_sent_total{kind="history"} 0
knell_notifications_sent_total{kind="missing"} 1
knell_notifications_sent_total{kind="recovered"} 1
# HELP knell_notifications_failed_total Webhook delivery attempts that failed after retries, by kind (missing, recovered, history); one per failed message. kind=recovered never moves here: recovered is fire-once with nothing left to retry, so a failed recovered send is counted on notifications_dropped_total instead.
# TYPE knell_notifications_failed_total counter
knell_notifications_failed_total{kind="history"} 1
knell_notifications_failed_total{kind="missing"} 0
knell_notifications_failed_total{kind="recovered"} 0
# HELP knell_notifications_dropped_total Notification messages that will never be delivered, by kind (missing, recovered, history); a fire-once recovered notice whose send failed with nothing left to retry from; distinct from a delivery that failed and will retry.
# TYPE knell_notifications_dropped_total counter
knell_notifications_dropped_total{kind="history"} 0
knell_notifications_dropped_total{kind="missing"} 0
knell_notifications_dropped_total{kind="recovered"} 1
# HELP knell_pre_route_refusals_total Requests refused before the mux routes, by reason (non_canonical_beat_path, host_not_allowed, auth_throttled); a diagnostic for a missing beat, not an alert source.
# TYPE knell_pre_route_refusals_total counter
knell_pre_route_refusals_total{reason="auth_throttled"} 2
knell_pre_route_refusals_total{reason="host_not_allowed"} 1
knell_pre_route_refusals_total{reason="non_canonical_beat_path"} 0
# HELP knell_http_requests_total Served HTTP requests by matched route template, method and status. Series are not pre-minted, so a status series is born with its first request and increase() cannot see that first event; alert on the absolute value (status=401 > 0), which latches until restart.
# TYPE knell_http_requests_total counter
knell_http_requests_total{method="GET",path="/metrics",status="200"} 1
knell_http_requests_total{method="GET",path="unmatched",status="404"} 1
knell_http_requests_total{method="POST",path="/beat/{id}",status="204"} 1
# HELP knell_listener_accept_errors_total Failed accepts on the ping listener, which retries them; a shutdown's close is not counted.
# TYPE knell_listener_accept_errors_total counter
knell_listener_accept_errors_total 1
# HELP knell_beat_fresh Whether the beat's observed silence is within its deadline (1 = fresh, 0 = overdue; silence runs from process start until the first ping).
# TYPE knell_beat_fresh gauge
knell_beat_fresh{beat="backup"} 1
knell_beat_fresh{beat="cron-nightly"} 0
# HELP knell_beat_last_seen_timestamp_seconds Unix timestamp of the beat's last accepted ping (process start until the first ping).
# TYPE knell_beat_last_seen_timestamp_seconds gauge
knell_beat_last_seen_timestamp_seconds{beat="backup"} 1700001500
knell_beat_last_seen_timestamp_seconds{beat="cron-nightly"} 1700000000
# HELP knell_beat_deadline_seconds Configured silence deadline per beat, in seconds.
# TYPE knell_beat_deadline_seconds gauge
knell_beat_deadline_seconds{beat="backup"} 1200
knell_beat_deadline_seconds{beat="cron-nightly"} 93601.5
# HELP knell_build_info Always 1; the version label is the version of the running knell build.
# TYPE knell_build_info gauge
knell_build_info{version="v1.2.3-dev.4"} 1
# HELP knell_http_request_duration_seconds Served HTTP request duration in seconds.
# TYPE knell_http_request_duration_seconds histogram
knell_http_request_duration_seconds_bucket{le="0.005"} 1
knell_http_request_duration_seconds_bucket{le="0.01"} 1
knell_http_request_duration_seconds_bucket{le="0.025"} 2
knell_http_request_duration_seconds_bucket{le="0.05"} 2
knell_http_request_duration_seconds_bucket{le="0.1"} 2
knell_http_request_duration_seconds_bucket{le="0.25"} 2
knell_http_request_duration_seconds_bucket{le="0.5"} 2
knell_http_request_duration_seconds_bucket{le="1"} 2
knell_http_request_duration_seconds_bucket{le="+Inf"} 3
knell_http_request_duration_seconds_sum 7.515
knell_http_request_duration_seconds_count 3
